# ─── Obrigatorias ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://quintal:quintal_dev@localhost:5433/meu_quintal?schema=public"

# Assina os JWT do app restaurante. Em producao o server RECUSA subir com menos
# de 32 chars ou com um valor de exemplo. Gere o seu:
#   openssl rand -base64 48
JWT_SECRET="dev-secret-trocar-em-producao-min-16-chars"

# ─── Rede ───────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Origens liberadas no CORS, separadas por virgula. Em producao precisam ser
# https e nao podem apontar pra localhost — o server valida isso no boot.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# ─── Opcionais (os defaults servem pra maioria dos casos) ───────────────────
# Teto do rate limit global, por IP, na janela abaixo.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW="1 minute"

# Tamanho maximo de body aceito, em bytes. Padrao 256 KB.
BODY_LIMIT=262144

# Habilita GET /metrics (Prometheus) e serve de senha pra ela. Vazio = rota
# desabilitada. Gere com: openssl rand -hex 32
METRICS_TOKEN=

# Tarefas periodicas do processo (encerrar propostas de alteracao vencidas).
# A operacao e idempotente, entao rodar em varias replicas nao duplica trabalho.
CRON_ENABLED=true

# Confiar em X-Forwarded-For pra descobrir o IP real do cliente.
# Ligar SOMENTE com um proxy/ingress conhecido na frente: com isso ligado e sem
# proxy, qualquer um forja o header e escapa do rate limit.
TRUST_PROXY=false

# ─── Sentry (opcional) ──────────────────────────────────────────────────────
# VAZIO = Sentry desligado, sem nenhum efeito no runtime. Este e o padrao.
#
# Cole o DSN do projeto pra ligar. So 5xx DESCONHECIDO vira evento — 4xx e o
# 503 de load shedding sao filtrados de proposito: mandar erro esperado torra a
# cota do plano free justamente durante um incidente.
SENTRY_DSN=

# Rotulo do ambiente no painel (producao, homologacao...). Padrao: NODE_ENV.
SENTRY_ENVIRONMENT=

# Fracao de requisicoes rastreadas, 0..1. PADRAO 0.
# Tracing gera um evento POR REQUISICAO. Subir isso sem olhar o consumo esvazia
# a cota do free em horas. Comece em 0.05 se quiser experimentar.
SENTRY_TRACES_SAMPLE_RATE=0

# Dias de teste gratis que uma conta NOVA recebe. Padrao 7.
#
# 0 DESLIGA O TESTE: a conta nasce com o teste ja vencido — a pessoa entra, ve
# tudo e nao altera nada ate assinar ("paga pra comecar").
#
# Vazio = nao configurado = 7. Nao confundir 0 com vazio.
#
# Isto NAO e o mesmo que trialEndsAt NULL no banco, que significa "esta conta
# nunca e suspensa por teste" (cortesia) e e decisao por conta, nao global.
TRIAL_DIAS=7

# ─── Web Push: o aviso que chega na cozinha com o app fechado ───────────────
# VAZIO = push desligado, e nada quebra: a tela de Avisos diz que nao esta
# ligado neste servidor, e o aviso de dentro do app (som + vibracao) continua
# igual. Mesma escolha do Resend e do Sentry.
#
# Gere o par UMA vez:   pnpm --filter @mq/server exec web-push generate-vapid-keys
#
# TROCAR A CHAVE DEPOIS INVALIDA TODA INSCRICAO EXISTENTE. Os aparelhos ja
# autorizados passam a receber 403 e sao apagados na primeira tentativa — ou
# seja, TODO MUNDO precisa ligar o aviso de novo, e nada avisa que isso
# aconteceu. Guarde a privada como segredo de verdade; ela nao vai pro front.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Como o servico de push (Google, Apple, Mozilla) fala com voce se algo der
# errado. Precisa ser mailto: ou uma URL https — exigencia do protocolo.
VAPID_SUBJECT=mailto:suporte@qro.app

# ─── Asaas: a mensalidade que o DONO paga pro QRO ───────────────────────────
# NAO confundir com a cobranca que o dono faz das cozinhas dele (aluguel e
# comissao) — aquele dinheiro nunca passa pelo app.
#
# VAZIO = pagamento desligado: nenhuma requisicao sai, a tela do dono diz que
# ainda nao esta ligado e o webhook responde 503. Mesma escolha do Resend.
ASAAS_API_KEY=

# sandbox | producao. PADRAO SANDBOX de proposito: o default seguro e o que nao
# move dinheiro de verdade.
#
# ATENCAO: producao apontando pro sandbox e o erro caro e silencioso — o
# checkout abre, o cliente "paga" com dinheiro de mentira, a conta ativa, e
# nunca entrou um centavo. Por isso NODE_ENV=production com sandbox e recusado
# no boot.
ASAAS_AMBIENTE=sandbox

# Segredo que o Asaas devolve no header `asaas-access-token` de todo webhook.
# E o unico jeito de saber que o POST veio mesmo dele — sem isso qualquer um
# na internet ativa a propria conta de graca.
#
# NAO PODE SER IGUAL A ASAAS_API_KEY (o proprio Asaas alerta, e o boot recusa).
# Gere com: openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=

# Mensalidade de cada plano, EM CENTAVOS (ex: 19900 = R$ 199,00).
# Sem padrao de proposito: um numero chutado viraria cobranca errada sem
# ninguem perceber. A rota de checkout recusa enquanto estiver vazio.
PRECO_RESTAURANTE_CENTS=
PRECO_PRACA_CENTS=
