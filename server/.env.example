# ─── Obrigatorias ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://quintal:quintal_dev@localhost:5433/meu_quintal?schema=public"

# Assina os JWT do app restaurante. Em producao o server RECUSA subir com menos
# de 32 chars ou com um valor de exemplo. Gere o seu:
#   openssl rand -base64 48
JWT_SECRET="dev-secret-trocar-em-producao-min-16-chars"

# ─── Rede ───────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Origens liberadas no CORS, separadas por virgula. Em producao precisam ser
# https e nao podem apontar pra localhost — o server valida isso no boot.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# ─── Opcionais (os defaults servem pra maioria dos casos) ───────────────────
# Teto do rate limit global, por IP, na janela abaixo.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW="1 minute"

# Tamanho maximo de body aceito, em bytes. Padrao 256 KB.
BODY_LIMIT=262144

# Habilita GET /metrics (Prometheus) e serve de senha pra ela. Vazio = rota
# desabilitada. Gere com: openssl rand -hex 32
METRICS_TOKEN=

# Tarefas periodicas do processo (encerrar propostas de alteracao vencidas).
# A operacao e idempotente, entao rodar em varias replicas nao duplica trabalho.
CRON_ENABLED=true

# Confiar em X-Forwarded-For pra descobrir o IP real do cliente.
# Ligar SOMENTE com um proxy/ingress conhecido na frente: com isso ligado e sem
# proxy, qualquer um forja o header e escapa do rate limit.
TRUST_PROXY=false

# ─── Sentry (opcional) ──────────────────────────────────────────────────────
# VAZIO = Sentry desligado, sem nenhum efeito no runtime. Este e o padrao.
#
# Cole o DSN do projeto pra ligar. So 5xx DESCONHECIDO vira evento — 4xx e o
# 503 de load shedding sao filtrados de proposito: mandar erro esperado torra a
# cota do plano free justamente durante um incidente.
SENTRY_DSN=

# Rotulo do ambiente no painel (producao, homologacao...). Padrao: NODE_ENV.
SENTRY_ENVIRONMENT=

# Fracao de requisicoes rastreadas, 0..1. PADRAO 0.
# Tracing gera um evento POR REQUISICAO. Subir isso sem olhar o consumo esvazia
# a cota do free em horas. Comece em 0.05 se quiser experimentar.
SENTRY_TRACES_SAMPLE_RATE=0
