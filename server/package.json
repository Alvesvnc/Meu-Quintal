{
  "name": "@mq/server",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "seed:tenant2": "tsx scripts/seed-tenant2.ts",
    "isolamento": "node scripts/isolamento.mjs",
    "bootstrap": "tsx src/bootstrap.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.1",
    "@fastify/under-pressure": "^9.1.0",
    "@mq/shared": "workspace:*",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.70.0",
    "argon2": "^0.44.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "resend": "^6.22.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
