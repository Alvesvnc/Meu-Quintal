# Variaveis do docker-compose.prod.yml.
#
#   cp .env.prod.example .env.prod   &&   editar
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# NUNCA versionar o .env.prod — ele esta no .gitignore. Em provedor gerenciado,
# cadastre estas variaveis no painel de secrets em vez de usar arquivo.

# ─── Banco ──────────────────────────────────────────────────────────────────
# PRODUCAO: cole aqui a URL do Postgres GERENCIADO e NAO use --profile with-db.
# Exija sslmode=require — sem isso a conexao trafega em claro.
#   DATABASE_URL=postgresql://user:senha@host.provedor.com:5432/meu_quintal?sslmode=require
#
# O que exigir do provedor (PITR, retencao, teste de restore) esta em
# docs/runbook-banco.md. NAO pule essa leitura antes do primeiro cliente.
#
# DEV/HOMOLOGACAO com --profile with-db: o host e `postgres`, nome do servico
# na rede do compose. Este Postgres NAO tem backup.
POSTGRES_USER=quintal
POSTGRES_PASSWORD=
POSTGRES_DB=meu_quintal
DATABASE_URL=postgresql://quintal:SENHA_AQUI@postgres:5432/meu_quintal?schema=public

# ─── Segredos ───────────────────────────────────────────────────────────────
# openssl rand -base64 48
JWT_SECRET=

# ─── Rede ───────────────────────────────────────────────────────────────────
# Dominios dos tres apps. Precisam ser https — o server recusa subir com http
# ou localhost quando NODE_ENV=production.
CORS_ORIGINS=https://app.qro.com.br,https://cozinha.qro.com.br,https://admin.qro.com.br

# Porta publicada no host. Atras de um reverse proxy (nginx/Caddy/Traefik),
# mantenha em 127.0.0.1 e deixe o proxy cuidar do TLS.
SERVER_PORT=3001

# ─── Front-end ──────────────────────────────────────────────────────────────
# URL PUBLICA da API, como o navegador do usuario a enxerga.
#
# ATENCAO: isto e BUILD ARG, nao variavel de runtime. O Vite assa este valor
# dentro do bundle JavaScript. Mudar aqui exige `--build` no compose; um
# restart nao adianta. Tambem entra no connect-src do CSP do nginx, entao um
# valor errado faz o app carregar e nao conseguir falar com a API.
VITE_API_URL=https://api.qro.com.br

# Portas dos apps no host. Em 127.0.0.1 de proposito: quem fala com a internet
# e termina TLS e o reverse proxy na frente.
CLIENTE_PORT=127.0.0.1:8081
RESTAURANTE_PORT=127.0.0.1:8082
DONO_PORT=127.0.0.1:8083

# Ligar quando houver reverse proxy na frente — sem proxy, deixe false.
TRUST_PROXY=true

RATE_LIMIT_MAX=300

# ─── Observabilidade ────────────────────────────────────────────────────────
# Habilita GET /metrics (Prometheus) e serve de senha pra ela. Vazio = rota
# desabilitada e invisivel (responde 404).
#   openssl rand -hex 32
METRICS_TOKEN=
# ─── Sentry (opcional) ──────────────────────────────────────────────────────
# VAZIO = Sentry desligado, sem nenhum efeito no runtime. Este e o padrao.
#
# Cole o DSN do projeto pra ligar. So 5xx DESCONHECIDO vira evento — 4xx e o
# 503 de load shedding sao filtrados de proposito: mandar erro esperado torra a
# cota do plano free justamente durante um incidente.
SENTRY_DSN=

# Rotulo do ambiente no painel (producao, homologacao...). Padrao: NODE_ENV.
SENTRY_ENVIRONMENT=

# Fracao de requisicoes rastreadas, 0..1. PADRAO 0.
# Tracing gera um evento POR REQUISICAO. Subir isso sem olhar o consumo esvazia
# a cota do free em horas. Comece em 0.05 se quiser experimentar.
SENTRY_TRACES_SAMPLE_RATE=0

# ─── Web Push (opcional) ────────────────────────────────────────────────────
# O aviso que chega na cozinha com o app FECHADO e a tela apagada.
#
# VAZIO = push desligado, e nada quebra: a tela de Avisos do app da cozinha
# diz que nao esta ligado neste servidor, e o aviso de dentro do app (som +
# vibracao, com a aba aberta) continua igual. Mesma escolha do Sentry.
#
# Gere o par com:
#   pnpm --filter @mq/server exec web-push generate-vapid-keys
#
# GERE UM PAR PROPRIO PRA PRODUCAO. Nao reaproveite o de desenvolvimento: a
# privada assina todo aviso enviado, e uma chave que ja passou por terminal,
# log ou chat deixou de ser segredo.
#
# A ESCOLHA E QUASE DEFINITIVA. Trocar a chave depois invalida TODA inscricao
# existente: os aparelhos ja autorizados passam a receber 403, sao apagados na
# primeira tentativa, e cada pessoa precisa ligar o aviso de novo — sem que
# nada na tela diga que isso aconteceu.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Como o servico de push (Google, Apple, Mozilla) fala com voce se algo der
# errado. Precisa ser mailto: ou uma URL https — exigencia do protocolo.
VAPID_SUBJECT=mailto:suporte@qro.com.br

# Tag da imagem. Em deploy real use o SHA do commit, nao `latest`.
TAG=latest
